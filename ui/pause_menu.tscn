[node name="Label16" type="Label" parent="GuidePanel/MarginContainer/Control/ScrollContainer/VBoxContainer/PageInventory" unique_id=32058639]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "All collected pages are listed on the right, available sockets are on the left.

There are three different type of Sockets and every page has a different effect depending
on where it is socketed.

To equip a Page first click on the Page and then on the socket on
the right to attach the page to it."

