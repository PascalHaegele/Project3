[node name="Label17" type="Label" parent="GuidePanel/MarginContainer/Control/ScrollContainer/VBoxContainer/Portals" unique_id=505724728]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Portals can be on the map, or have chance to appear when stepping on a raised circle.

Yellow portals transport the player to a different location on the same map.
Green portals advance the player to a new map,
or return the player to the hub if it's next to a purple portal.
Purple portals start another loop of the playthrough while also increasing the difficulty."

